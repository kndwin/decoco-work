---
import Layout from '../../layouts/Layout.astro';
import ProductCard from '../../components/ProductCard.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { categories } from '../../data/categories';
import { getProductsByCategory } from '../../data/products';
---

<Layout>
  <section class="w-full max-w-6xl mx-auto px-4 pt-8 pb-20">
    <Breadcrumb items={[{ label: 'Products' }]} />

    <div class="mb-12 text-center">
      <h1 class="text-3xl md:text-4xl font-semibold mt-2">The Collection</h1>
      <p class="text-gray-600 mt-4 max-w-2xl mx-auto">
        Every piece here we would happily live with ourselves. Sofa sets and a bedroom
        suite — no filler, no flat-pack.
      </p>
    </div>

    <!-- Category Navigation -->
    <div class="flex flex-wrap justify-center gap-2 mb-16">
      {
        categories.map((category) => (
          <a
            href={`/products/category/${category.slug}`}
            class="px-4 py-2 rounded-full border border-gray-300 hover:border-black transition text-sm"
          >
            {' '}
            {category.title}{' '}
          </a>
        ))
      }
    </div>

    {
      categories.map((category) => {
        const categoryProducts = getProductsByCategory(category.slug);
        const displayName = category.slug.replace('-', ' ');
        return (
          <div class="mb-16">
            <div class="flex justify-between items-center mb-8">
              <h2 class="text-2xl font-semibold capitalize"> {displayName} </h2>
              <a
                href={`/products/category/${category.slug}`}
                class="text-black font-medium border-b border-black pb-1 hidden md:block"
              >
                View All {displayName}{' '}
              </a>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 md:gap-8">
              {categoryProducts.map((product) => (
                <ProductCard product={product} />
              ))}
            </div>
            <div class="mt-8 text-center md:hidden">
              <a
                href={`/products/category/${category.slug}`}
                class="inline-block border border-gray-300 px-6 py-3 rounded-md hover:border-black transition"
              >
                View All {displayName}{' '}
              </a>
            </div>
          </div>
        );
      })
    }
  </section>
</Layout>
