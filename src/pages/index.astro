---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import { products } from '../data/products';

const featured = products.slice(0, 6);
---

<Layout>
  <section class="w-full max-w-6xl mx-auto px-4 pt-8 pb-20">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      <div>
        <h1 class="text-5xl md:text-6xl font-semibold leading-none mb-6">
          A small, careful <br />collection.
        </h1>
        <p class="text-gray-600 text-lg mb-8 max-w-md">
          A handful of sofa sets and bedroom pieces — chosen one at a time, for how they
          live-in over a decade rather than how they photograph on day one.
        </p>
        <div class="flex flex-col sm:flex-row gap-4">
          <a
            href="/products"
            class="bg-black text-white px-8 py-3 rounded-md text-center hover:bg-gray-800 transition"
          >
            Shop Collection
          </a>
        </div>
      </div>
      <div class="rounded-2xl overflow-hidden shadow-xl border border-gray-200">
        <img
          src="/images/screenshots/black-chesterfield-living-room.png"
          alt="Black leather Chesterfield sofa in a brick loft"
          class="w-full h-full object-cover"
          fetchpriority="high"
        />
      </div>
    </div>
  </section>

  <section class="w-full max-w-6xl mx-auto px-4 pt-8 pb-20">
    <div class="flex justify-between items-end mb-12">
      <div>
        <span class="text-sm font-medium uppercase tracking-wider text-gray-500">
          New Arrivals
        </span>
        <h2 class="text-3xl md:text-4xl font-semibold mt-2">Featured Products</h2>
      </div>
      <a
        href="/products"
        class="text-black font-medium border-b border-black pb-1 hidden md:block"
      >
        View All Products
      </a>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
      {featured.map((product) => <ProductCard product={product} />)}
    </div>
    <div class="mt-8 text-center md:hidden">
      <a
        href="/products"
        class="inline-block border border-gray-300 px-6 py-3 rounded-md hover:border-black transition"
      >
        View All Products
      </a>
    </div>
  </section>

  <section class="w-full max-w-6xl mx-auto px-4 pt-8 pb-20">
    <div class="bg-white rounded-2xl p-8 md:p-12 shadow-sm border border-gray-100">
      <div class="max-w-2xl mx-auto text-center">
        <div
          class="bg-gray-100 w-16 h-16 rounded-full mx-auto flex items-center justify-center mb-4"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="1.5"
            stroke="currentColor"
            class="w-8 h-8"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09zM18.259 8.715L18 9.75l-.259-1.035a3.375 3.375 0 00-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 002.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 002.456 2.456L21.75 6l-1.035.259a3.375 3.375 0 00-2.456 2.456zM16.894 20.567L16.5 21.75l-.394-1.183a2.25 2.25 0 00-1.423-1.423L13.5 18.75l1.183-.394a2.25 2.25 0 001.423-1.423l.394-1.183.394 1.183a2.25 2.25 0 001.423 1.423l1.183.394-1.183.394a2.25 2.25 0 00-1.423 1.423z"
            ></path>
          </svg>
        </div>
        <h2 class="text-2xl md:text-3xl font-semibold mb-3">Your color, your idea, we make it</h2>
        <p class="text-gray-600">
          Pick the tone, texture and silhouette you have in mind. We shape each sofa set
          or bedroom piece around your room, your palette and the way you want it to feel.
        </p>
      </div>
    </div>
  </section>

</Layout>
