---
import '../styles/global.css';
import background from '../assets/background.svg';
import logo from '../assets/logo.svg';

interface Props {
  title?: string;
}

const { title = 'Decoco' } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700&family=Raleway:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body class="antialiased text-gray-800 bg-gray-50 relative">
    <!-- Background - moved this first and set proper z-index -->
    <div
      class="opacity-80 blur-[15px] absolute top-0 right-0 w-1/3 h-full bg-gradient-to-tr from-amber-50/50 to-red-100 rounded-l-full"
    >
    </div>
    <div
      class="opacity-20 blur-[10px] absolute bottom-0 left-0 w-1/2 h-1/2 bg-gradient-to-tr from-blue-50 to-purple-100 rounded-tr-full"
    >
    </div>
    <img
      class="absolute top-0 left-0 w-full h-full object-cover blur-[100px] opacity-20"
      src={background.src}
      alt=""
    />

    <!-- Content wrapper - now properly positioned above background -->
    <div class="relative z-10 bg-transparent">
      <header
        class="w-full max-w-6xl mx-auto px-4 pt-8 pb-8 flex justify-between items-center relative"
      >
        <a href="/" class="flex items-center gap-2">
          <img src={logo.src} alt="Decoco Logo" class="size-6" />
          <p class="font-bold">decoco</p>
        </a>

        <!-- Desktop Menu -->
        <nav class="hidden md:flex space-x-8">
          <a href="/products" class="font-medium hover:text-gray-600 transition">Products</a>
          <a
            href="/products/category/living-room"
            class="font-medium hover:text-gray-600 transition">Living Room</a
          >
          <a href="/products/category/bedroom" class="font-medium hover:text-gray-600 transition"
            >Bedroom</a
          >
          <a href="/products/category/dining" class="font-medium hover:text-gray-600 transition"
            >Dining</a
          >
        </nav>

        <!-- Mobile Menu Button -->
        <button id="menu-button" class="md:hidden focus:outline-none" aria-label="Toggle menu">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1920 1920" class="size-6">
            <path
              d="M1920 1468.412v112.94H0v-112.94h1920Zm0-564.706v112.941H0V903.706h1920ZM1920 339v112.941H0V339h1920Z"
              fill-rule="evenodd"></path>
          </svg>
        </button>
        <script>
          document.addEventListener('DOMContentLoaded', () => {
            const button = document.getElementById('menu-button');
            const menu = document.getElementById('mobile-menu');
            button?.addEventListener('click', () => {
              menu && menu.classList.toggle('hidden');
            });
          });
        </script>

        <!-- Mobile Menu Dropdown -->
        <div
          id="mobile-menu"
          class="hidden absolute top-full right-0 left-0 bg-white shadow-lg rounded-lg mt-2 py-4 z-50 md:hidden"
        >
          <nav class="flex flex-col space-y-3 px-6">
            <a href="/products" class="font-medium hover:text-gray-600 transition py-2">Products</a>
            <a
              href="/products/category/living-room"
              class="font-medium hover:text-gray-600 transition py-2">Living Room</a
            >
            <a
              href="/products/category/bedroom"
              class="font-medium hover:text-gray-600 transition py-2">Bedroom</a
            >
            <a
              href="/products/category/dining"
              class="font-medium hover:text-gray-600 transition py-2">Dining</a
            >
          </nav>
        </div>
      </header>

      <slot />

      <footer class="bg-gray-900 text-white mt-16 pt-16 pb-8">
        <div class="w-full max-w-6xl mx-auto px-4">
          <div class="grid grid-cols-1 md:grid-cols-3 gap-8 pb-8 border-b border-gray-700">
            <div>
              <div class="flex items-center gap-3 mb-6">
                <div class="w-10 h-10 bg-white rounded-full flex items-center justify-center">
                  <img src={logo.src} alt="Sophia Furniture Logo" class="w-5 h-5" />
                </div>
                <p class="font-bold text-xl tracking-tight">decoco</p>
              </div>
              <p class="text-gray-400 mb-6">
                Thoughtfully designed furniture for modern living spaces.
              </p>
              <div class="flex gap-4">
                <a
                  href="#"
                  class="text-gray-400 hover:text-white transition"
                  aria-label="Instagram"
                >
                  <svg
                    fill="currentColor"
                    width="24"
                    height="24"
                    viewBox="0 0 24 24"
                    xmlns="http://www.w3.org/2000/svg"
                  >
                    <path
                      d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"
                    ></path>
                  </svg>
                </a>
                <a
                  href="#"
                  class="text-gray-400 hover:text-white transition"
                  aria-label="Facebook"
                >
                  <svg
                    fill="currentColor"
                    width="24"
                    height="24"
                    viewBox="0 0 24 24"
                    xmlns="http://www.w3.org/2000/svg"
                  >
                    <path
                      d="M22.675 0h-21.35c-.732 0-1.325.593-1.325 1.325v21.351c0 .731.593 1.324 1.325 1.324h11.495v-9.294h-3.128v-3.622h3.128v-2.671c0-3.1 1.893-4.788 4.659-4.788 1.325 0 2.463.099 2.795.143v3.24l-1.918.001c-1.504 0-1.795.715-1.795 1.763v2.313h3.587l-.467 3.622h-3.12v9.293h6.116c.73 0 1.323-.593 1.323-1.325v-21.35c0-.732-.593-1.325-1.325-1.325z"
                    ></path>
                  </svg>
                </a>
              </div>
            </div>
            <div>
              <h3 class="font-bold text-lg mb-4">Shop</h3>
              <ul class="space-y-2">
                <li>
                  <a
                    href="/products/category/living-room"
                    class="text-gray-400 hover:text-white transition">Living Room</a
                  >
                </li>
                <li>
                  <a
                    href="/products/category/bedroom"
                    class="text-gray-400 hover:text-white transition">Bedroom</a
                  >
                </li>
                <li>
                  <a
                    href="/products/category/dining"
                    class="text-gray-400 hover:text-white transition">Dining</a
                  >
                </li>
                <li>
                  <a href="/products" class="text-gray-400 hover:text-white transition"
                    >All Products</a
                  >
                </li>
              </ul>
            </div>
            <div>
              <h3 class="font-bold text-lg mb-4">Navigate</h3>
              <ul class="space-y-2">
                <li>
                  <a href="/" class="text-gray-400 hover:text-white transition">Home</a>
                </li>
                <li>
                  <a href="/products" class="text-gray-400 hover:text-white transition">Products</a>
                </li>
                <li>
                  <a
                    href="/products/category/living-room"
                    class="text-gray-400 hover:text-white transition">Living Room</a
                  >
                </li>
                <li>
                  <a
                    href="/products/category/bedroom"
                    class="text-gray-400 hover:text-white transition">Bedroom</a
                  >
                </li>
                <li>
                  <a
                    href="/products/category/dining"
                    class="text-gray-400 hover:text-white transition">Dining</a
                  >
                </li>
              </ul>
            </div>
          </div>
          <div class="pt-8 text-center text-gray-400 text-sm">
            <p>&copy; 2025 Decoco. All rights reserved.</p>
          </div>
        </div>
      </footer>
    </div>
  </body>
</html>

<style is:global>
  body {
    font-family: 'Raleway', sans-serif;
  }
  h1,
  h2,
  h3,
  h4,
  h5 {
    font-family: 'Playfair Display', serif;
  }
</style>
